# Copy to .env and fill in. Never commit .env. Values are optional unless marked REQUIRED.

# --- core ---------------------------------------------------------------------
# REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
LOGIDX_SECRET_KEY=
# REQUIRED for Docker Compose
POSTGRES_PASSWORD=
# Local default is SQLite under ./data; Compose sets PostgreSQL itself.
# LOGIDX_DATABASE_URL=sqlite:///data/logidx.db
LOGIDX_TIMEZONE=Australia/Melbourne
# false only for plain-http local development
LOGIDX_COOKIE_SECURE=true
# Included in the User-Agent so site operators can contact you
LOGIDX_CONTACT_EMAIL=

# --- serverless hosting (Vercel) — see docs/03-deploy-vercel.md -------------------
# Vercel sets VERCEL=1, which switches on serverless mode. Neon sets DATABASE_URL.
# CRON_SECRET=
# LOGIDX_ADMIN_EMAIL=
# LOGIDX_ADMIN_PASSWORD=          # first login only; delete after signing in
# LOGIDX_RUN_TIME_BUDGET=240

# --- AI (xAI Grok) --------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4
# USD per million tokens, for cost tracking — check current xAI pricing
LOGIDX_AI_PRICE_INPUT_PER_MTOK=3.0
LOGIDX_AI_PRICE_OUTPUT_PER_MTOK=15.0
LOGIDX_AI_DAILY_BUDGET_USD=5.0
LOGIDX_AI_MAX_PER_RUN=40

# --- sources ----------------------------------------------------------------------
# Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional indexed fallback (labelled INDEXED FALLBACK ONLY)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- email (daily report) -----------------------------------------------------------
# Gmail: smtp.gmail.com, port 587, with an App Password (not your account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LOGIDX_REPORT_RECIPIENT=
