# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://cardcore:cardcore@localhost:5432/cardcore
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
PHOTO_STORAGE_DIR=./storage/photos
# Synthetic demo evidence source — must be false in production.
ENABLE_DEMO_SOURCE=true
# Optional: TCGdex catalogue lookups (open API, MIT-licensed card database).
ENABLE_TCGDEX=true
# Optional: PokeTrace API (https://poketrace.com). Free keys give averages only (price guides);
# individual eBay sold listings need a Pro plan. Keep this in the environment's secrets, never in git.
POKETRACE_API_KEY=
# Set true only once the plan's terms permit commercial use; otherwise evidence is disclosed as unlicensed.
POKETRACE_COMMERCIAL_LICENCE=false
# Photo storage: "local" (PHOTO_STORAGE_DIR) or "vercel-blob" (private Vercel Blob; the default on Vercel).
# PHOTO_STORAGE=local
# Scheduled jobs on serverless hosts: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (16+ characters).
# CRON_SECRET=
