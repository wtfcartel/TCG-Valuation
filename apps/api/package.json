{
  "name": "@cardcore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts src/migrate.ts src/seed.ts src/create-admin.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --alias:@cardcore/engine=../../packages/engine/src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "create-admin": "tsx src/create-admin.ts"
  },
  "dependencies": {
    "@cardcore/engine": "0.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.3.0",
    "jose": "^6.0.10",
    "pdfkit": "^0.17.0",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
    "esbuild": "^0.25.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
